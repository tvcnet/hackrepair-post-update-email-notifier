<?xml version="1.0"?>
<ruleset name="Post Update Email Notifier">
	<description>WordPress coding standards for the Post Update Email Notifier plugin.</description>

	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg value="sp"/>
	<arg name="extensions" value="php"/>

	<file>post-update-email-notifier.php</file>
	<file>includes</file>
	<file>uninstall.php</file>
	<!-- Standalone test stubs are not shipped plugin code. -->
	<exclude-pattern>*/tests/*</exclude-pattern>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<!-- Vendored third-party library (Plugin Update Checker by Janis Elsts, MIT licensed); not our code to re-style. -->
	<exclude-pattern>*/plugin-update-checker/*</exclude-pattern>

	<config name="minimum_wp_version" value="6.6"/>
	<config name="testVersion" value="7.4-"/>

	<rule ref="WordPress-Extra"/>
	<rule ref="PHPCompatibilityWP"/>
</ruleset>
